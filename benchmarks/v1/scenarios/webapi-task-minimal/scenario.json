{
  "id": "webapi-task-minimal",
  "name": "Minimal Web API task manager",
  "projectType": "WebApi",
  "benchmarkVersion": "1.0.0",
  "targetFramework": "net9.0",
  "sdkVersion": "9.0.100",
  "instructionsFile": "instructions.md",
  "contractsFile": "contracts.md",
  "starterDirectory": "starter",
  "acceptanceProject": "acceptance/WebApiTaskMinimal.Acceptance.csproj",
  "allowedPackages": [
    "Microsoft.Data.Sqlite",
    "Microsoft.EntityFrameworkCore",
    "Microsoft.EntityFrameworkCore.Sqlite",
    "Microsoft.EntityFrameworkCore.Design",
    "Microsoft.NET.Test.Sdk",
    "Microsoft.AspNetCore.Mvc.Testing",
    "xunit",
    "xunit.runner.visualstudio",
    "coverlet.collector"
  ],
  "requiredGlobs": [
    "*.sln",
    "src/**/*.csproj",
    "tests/**/*.csproj",
    "README.md"
  ],
  "preservedPaths": [
    "global.json",
    ".editorconfig",
    "BENCHMARK.md"
  ],
  "budget": {
    "generationTimeoutSeconds": 1800,
    "buildTimeoutSeconds": 900,
    "testTimeoutSeconds": 900,
    "acceptanceTimeoutSeconds": 1200
  },
  "samples": {
    "good": {
      "path": "samples/good",
      "description": "Reference implementation that satisfies the full HTTP contract."
    },
    "broken": {
      "path": "samples/good",
      "overlay": "samples/broken-overlay",
      "description": "Reference implementation with deliberate contract violations (wrong status code, missing Location header and no title validation)."
    }
  }
}

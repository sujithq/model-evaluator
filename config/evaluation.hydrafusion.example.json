{
  "benchmarkRoot": "../benchmarks/v1",
  "outputDirectory": "../artifacts/evaluations",
  "repetitions": 3,
  "scenarios": [],
  "models": [
    
    {
      "id": "copilot-claude-opus-5.5",
      "enabled": true,
      "adapter": "command-line",
      "description": "Fixed Claude Opus 5.5 baseline generating projects through GitHub Copilot CLI.",
      "settings": {
        "command": "copilot",
        "arguments": "--model claude-opus-5.5 --prompt \"{prompt}\" --allow-all-tools --disable-builtin-mcps --no-custom-instructions --no-ask-user --no-auto-update --usage-output-file \"{usageFile}\"",
        "runnerName": "github-copilot-cli",
        "usageFile": "usage.json",
        "usageFormat": "copilot-cli"
      }
    },
    {
      "id": "copilot-gpt-6-astra",
      "enabled": false,
      "adapter": "command-line",
      "description": "Fixed GPT-6 Astra baseline generating projects through GitHub Copilot CLI.",
      "settings": {
        "command": "copilot",
        "arguments": "--model gpt-6-astra --prompt \"{prompt}\" --allow-all-tools --disable-builtin-mcps --no-custom-instructions --no-ask-user --no-auto-update --usage-output-file \"{usageFile}\"",
        "runnerName": "github-copilot-cli",
        "usageFile": "usage.json",
        "usageFormat": "copilot-cli"
      }
    },
    {
      "id": "copilot-auto",
      "enabled": true,
      "adapter": "command-line",
      "description": "Auto routing (not a fixed model) generating projects through GitHub Copilot CLI.",
      "settings": {
        "command": "copilot",
        "arguments": "--model auto --prompt \"{prompt}\" --allow-all-tools --disable-builtin-mcps --no-custom-instructions --no-ask-user --no-auto-update --usage-output-file \"{usageFile}\"",
        "runnerName": "github-copilot-cli",
        "usageFile": "usage.json",
        "usageFormat": "copilot-cli"
      }
    },
    {
      "id": "copilot-hydrafusion",
      "enabled": true,
      "adapter": "command-line",
      "description": "HydraFusion orchestration system generating projects through GitHub Copilot CLI.",
      "settings": {
        "command": "copilot",
        "arguments": "--experimental --model hydrafusion --prompt \"{prompt}\" --allow-all-tools --disable-builtin-mcps --no-custom-instructions --no-ask-user --no-auto-update --usage-output-file \"{usageFile}\"",
        "runnerName": "github-copilot-cli",
        "usageFile": "usage.json",
        "usageFormat": "copilot-cli"
      }
    },
    {
      "id": "copilot-hydrafusion-max",
      "enabled": true,
      "adapter": "command-line",
      "description": "HydraFusion Max orchestration system generating projects through GitHub Copilot CLI.",
      "settings": {
        "command": "copilot",
        "arguments": "--experimental --model hydrafusion-max --prompt \"{prompt}\" --allow-all-tools --disable-builtin-mcps --no-custom-instructions --no-ask-user --no-auto-update --usage-output-file \"{usageFile}\"",
        "runnerName": "github-copilot-cli",
        "usageFile": "usage.json",
        "usageFormat": "copilot-cli"
      }
    }
  ],
  "budgets": {
    "generationTimeoutSeconds": 7200
  },
  "keepWorkspaces": false
}

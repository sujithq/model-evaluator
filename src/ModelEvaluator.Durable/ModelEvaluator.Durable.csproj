<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ModelEvaluator.Core\ModelEvaluator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DurableTask.Client.AzureManaged" Version="1.17.0" />
    <PackageReference Include="Microsoft.DurableTask.Worker.AzureManaged" Version="1.17.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\config\**\*.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="config\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\benchmarks\**\*"
          Exclude="..\..\benchmarks\**\bin\**;..\..\benchmarks\**\obj\**"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="benchmarks\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

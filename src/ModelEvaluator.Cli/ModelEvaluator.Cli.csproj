<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>model-evaluator</ToolCommandName>
    <PackageId>Sujithq.ModelEvaluator</PackageId>
    <PackageDescription>Compare AI model behavior and .NET integration paths with controlled, synthetic scenarios.</PackageDescription>
    <UserSecretsId>Sujithq.ModelEvaluator.Cli</UserSecretsId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelEvaluator.Core\ModelEvaluator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\scenarios\**\*.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="scenarios\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\config\**\*.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="config\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
